<?xml version="1.0"?>
<model>
    <mount>//OPNsense/mihomo</mount>
    <version>1.0.0</version>
    <description>mihomo proxy integration settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
                <ValidationMessage>Enable the mihomo service at boot time.</ValidationMessage>
            </enabled>
            <logLevel type="OptionField">
                <Default>info</Default>
                <Required>Y</Required>
                <OptionValues>
                    <debug>debug</debug>
                    <info>info</info>
                    <warning>warning</warning>
                    <error>error</error>
                    <silent>silent</silent>
                </OptionValues>
            </logLevel>
            <mode type="OptionField">
                <Default>rule</Default>
                <Required>Y</Required>
                <OptionValues>
                    <rule>rule</rule>
                    <global>global</global>
                    <direct>direct</direct>
                </OptionValues>
            </mode>
            <controllerBind type="TextField">
                <Default>127.0.0.1</Default>
                <Required>Y</Required>
                <Mask>/^(?:\*|[0-9]{1,3}(?:\.[0-9]{1,3}){3}|\[[0-9a-fA-F:]+\])$/</Mask>
                <ValidationMessage>Enter an IP address, e.g. 127.0.0.1 (loopback only, recommended) or 0.0.0.0 (all interfaces).</ValidationMessage>
            </controllerBind>
            <controllerPort type="PortField">
                <Default>9090</Default>
                <Required>Y</Required>
            </controllerPort>
            <secret type="TextField">
                <Mask>/^[0-9a-zA-Z_.\-]{0,128}$/</Mask>
                <ValidationMessage>Use up to 128 characters: letters, digits, ".", "-" and "_".</ValidationMessage>
            </secret>
            <allowLan type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </allowLan>
        </general>
        <tun>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <device type="TextField">
                <Default>tun_mihomo</Default>
                <Required>Y</Required>
                <Mask>/^[a-zA-Z0-9_]{1,15}$/</Mask>
                <ValidationMessage>Interface name is limited to 15 characters (letters, digits, underscore).</ValidationMessage>
            </device>
            <stack type="OptionField">
                <Default>gvisor</Default>
                <Required>Y</Required>
                <OptionValues>
                    <system>system</system>
                    <gvisor>gvisor</gvisor>
                    <mixed>mixed</mixed>
                </OptionValues>
            </stack>
            <autoRoute type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </autoRoute>
            <strictRoute type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </strictRoute>
            <mtu type="IntegerField">
                <Default>1500</Default>
                <Required>Y</Required>
                <MinimumValue>576</MinimumValue>
                <MaximumValue>9000</MaximumValue>
            </mtu>
        </tun>
        <dns>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <listen type="TextField">
                <Default>127.0.0.1:1053</Default>
                <Required>Y</Required>
                <Mask>/^(?:\*|[0-9]{1,3}(?:\.[0-9]{1,3}){3}|\[[0-9a-fA-F:]+\]):[0-9]{1,5}$/</Mask>
                <ValidationMessage>Enter a listen address including port, e.g. 127.0.0.1:1053.</ValidationMessage>
            </listen>
            <enhancedMode type="OptionField">
                <Default>fake-ip</Default>
                <Required>Y</Required>
                <OptionValues>
                    <fake-ip>fake-ip</fake-ip>
                    <redir-host>redir-host</redir-host>
                </OptionValues>
            </enhancedMode>
        </dns>
        <subscription>
            <url type="TextField">
                <Mask>/^(?:https?:\/\/[^\s]{1,500})?$/</Mask>
                <ValidationMessage>Enter an http(s) subscription URL, or leave empty.</ValidationMessage>
            </url>
            <secret type="TextField">
                <Mask>/^[0-9a-zA-Z_.\-]{0,128}$/</Mask>
                <ValidationMessage>Use up to 128 characters: letters, digits, ".", "-" and "_".</ValidationMessage>
            </secret>
            <restartAfterUpdate type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
                <ValidationMessage>Restart mihomo right after a successful subscription update.</ValidationMessage>
            </restartAfterUpdate>
        </subscription>
    </items>
</model>
