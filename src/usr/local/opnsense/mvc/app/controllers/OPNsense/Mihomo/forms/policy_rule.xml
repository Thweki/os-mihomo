<form>
    <field>
        <id>mihomo.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <grid_view>
            <width>6</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
            <sequence>5</sequence>
            <align>center</align>
            <selectable>false</selectable>
        </grid_view>
    </field>
    <field>
        <id>mihomo.interface</id>
        <label>Interface</label>
        <type>dropdown</type>
        <help>Interface whose traffic goes through mihomo.</help>
        <grid_view>
            <sequence>10</sequence>
        </grid_view>
    </field>
    <field>
        <id>mihomo.scope</id>
        <label>Scope</label>
        <type>dropdown</type>
        <help>Foreign: domestic traffic stays direct. All: everything through the proxy group.</help>
        <grid_view>
            <sequence>20</sequence>
        </grid_view>
    </field>
    <field>
        <id>mihomo.target</id>
        <label>Proxy group</label>
        <type>dropdown</type>
        <help>Traffic exits through this group. Ignored for the direct scope.</help>
        <grid_view>
            <sequence>30</sequence>
        </grid_view>
    </field>
    <field>
        <id>mihomo.source</id>
        <label>Source</label>
        <type>text</type>
        <help>Optional. Empty uses the interface network.</help>
        <advanced>true</advanced>
        <grid_view>
            <sequence>40</sequence>
            <visible>false</visible>
        </grid_view>
    </field>
    <field>
        <id>mihomo.firewall</id>
        <label>Firewall rule</label>
        <type>dropdown</type>
        <help>Create: the plugin creates the interface, gateway and firewall rule for this interface. Keep: you route the traffic yourself.</help>
        <grid_view>
            <sequence>50</sequence>
        </grid_view>
    </field>
    <field>
        <id>mihomo.descr</id>
        <label>Description</label>
        <type>text</type>
        <grid_view>
            <sequence>60</sequence>
        </grid_view>
    </field>
</form>
