# os-mihomo 插件中文（简体）翻译
# 由 tools/i18n_translate.py 生成；词条与源码严格一致，%s 占位符保持顺序不变。
# 用法（设备上）：tools/i18n.ps1 会调用 tools/mo_editor.py 合并进系统 OPNsense.mo
#
msgid ""
msgstr ""
"Project-Id-Version: os-mihomo 1.1.0\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "%s does not exist, the service cannot start."
msgstr "%s 不存在，服务无法启动。"

msgid "(no output)"
msgstr "（无输出）"

msgid "A node name is required."
msgstr "需要提供节点名称。"

msgid "Access Secret"
msgstr "访问密钥"

msgid "Active Connections"
msgstr "活动连接"

msgid "Active configuration is invalid"
msgstr "当前配置无效"

msgid "Active configuration is valid"
msgstr "当前配置有效"

msgid "Address the RESTful controller listens on. Keep 127.0.0.1 so that only this firewall can reach it — this WebGUI talks to the controller over the loopback interface."
msgstr "控制器监听的地址。保持 127.0.0.1，使只有本机可以访问 —— 本 WebGUI 通过回环接口与控制器通信。"

msgid "All connections closed."
msgstr "已关闭全部连接。"

msgid "Allow LAN"
msgstr "允许局域网"

msgid "Allow clients from the local network to use the SOCKS/HTTP proxy ports directly."
msgstr "允许局域网客户端直接使用 SOCKS/HTTP 代理端口。"

msgid "Apply failed"
msgstr "应用失败"

msgid "Automatic Route"
msgstr "自动路由"

msgid "Automatically insert routes for all traffic into the TUN device. This is what makes mihomo a transparent gateway — and what turns an unconfigured proxy into an outage."
msgstr "自动把所有流量的路由指向 TUN 设备。这是 mihomo 成为透明网关的关键 —— 也正因如此，节点未配置好就启动会导致断网。"

msgid "Bind Address"
msgstr "绑定地址"

msgid "Chain"
msgstr "链路"

msgid "Clear Log"
msgstr "清空日志"

msgid "Clear log?"
msgstr "清空日志？"

msgid "Close all"
msgstr "全部断开"

msgid "Configuration File"
msgstr "配置文件"

msgid "Configuration content must not be empty."
msgstr "配置内容不能为空。"

msgid "Configuration file %s is missing. Install the plugin first."
msgstr "配置文件 %s 不存在，请先安装插件。"

msgid "Configuration file is missing"
msgstr "配置文件缺失"

msgid "Configuration file not found."
msgstr "未找到配置文件。"

msgid "Configuration file updated and validated."
msgstr "配置文件已更新并通过校验。"

msgid "Configuration saved"
msgstr "配置已保存"

msgid "Configuration syntax is invalid"
msgstr "配置语法无效"

msgid "Configuration syntax is valid"
msgstr "配置语法有效"

msgid "Connection closed."
msgstr "连接已断开。"

msgid "Controller responded with HTTP code %s."
msgstr "控制器返回 HTTP 状态码 %s。"

msgid "Core log"
msgstr "内核日志"

msgid "Create a virtual network device so that traffic can be routed into mihomo without touching client configuration."
msgstr "创建虚拟网络设备，无需改动客户端配置即可把流量导入 mihomo。"

msgid "DNS Module"
msgstr "DNS 模块"

msgid "DNS hijacking is configured"
msgstr "已配置 DNS 劫持"

msgid "DNS queries on port 53 are redirected into mihomo while the service runs. If the proxy is broken, name resolution for all clients behind this firewall breaks with it."
msgstr "服务运行期间，53 端口的 DNS 查询会被重定向到 mihomo。若代理失效，本机后面所有客户端的域名解析也会随之失效。"

msgid "Direct"
msgstr "直连"

msgid "Download / Upload"
msgstr "下载 / 上传"

msgid "Edit Policy Rule"
msgstr "编辑路由策略"

msgid "Enable mihomo"
msgstr "启用 mihomo"

msgid "Enable the mihomo service at boot time."
msgstr "开机时启动 mihomo 服务。"

msgid "Enhanced Mode"
msgstr "增强模式"

msgid "Enter HTTP or HTTPS subscription URL"
msgstr "输入 HTTP 或 HTTPS 订阅地址"

msgid "Enter a listen address including port, e.g. 127.0.0.1:1053."
msgstr "输入监听地址（含端口），例如 127.0.0.1:1053。"

msgid "Enter an IP address, e.g. 127.0.0.1 (loopback only, recommended) or 0.0.0.0 (all interfaces)."
msgstr "输入 IP 地址，例如 127.0.0.1（仅回环，推荐）或 0.0.0.0（所有接口）。"

msgid "Enter an http(s) subscription URL, or leave empty."
msgstr "输入 http(s) 订阅地址，也可以留空。"

msgid "Enter dashboard access secret"
msgstr "输入控制面板访问密钥"

msgid "External Controller"
msgstr "外部控制器"

msgid "External controller has no secret"
msgstr "外部控制器未设置密钥"

msgid "External controller is not configured in the mihomo configuration file."
msgstr "mihomo 配置文件中未设置外部控制器。"

msgid "External controller is reachable from the network"
msgstr "外部控制器可从网络访问"

msgid "Failed to save the subscription settings."
msgstr "保存订阅设置失败。"

msgid "Foreign only"
msgstr "仅国外"

msgid "Foreign: domestic traffic stays direct. All: everything through the outbound."
msgstr "仅国外：国内直连，国外走所选出口；全部：所有流量都走所选出口。"

msgid "Group and member are required."
msgstr "需要提供分组与节点名称。"

msgid "HTTP(S) URL of your subscription. It is stored in the plugin environment file and used by the subscription updater."
msgstr "订阅的 HTTP(S) 地址。它保存在插件的环境文件中，供订阅更新器使用。"

msgid "Import failed"
msgstr "导入失败"

msgid "Import from configuration file"
msgstr "从配置文件导入"

msgid "Interface \"%s\" has no IPv4 network; set a source explicitly."
msgstr "接口 \"%s\" 没有 IPv4 网段，请显式填写源。"

msgid "Interface name is limited to 15 characters (letters, digits, underscore)."
msgstr "接口名最多 15 个字符（字母、数字、下划线）。"

msgid "Interface name of the TUN device. It must match the interface that the firewall rules refer to (default tun_mihomo)."
msgstr "TUN 设备的接口名。必须与防火墙规则引用的接口一致（默认 tun_mihomo）。"

msgid "Interface whose traffic goes through mihomo."
msgstr "流量进入 mihomo 的物理接口。"

msgid "Interface: the plugin also creates the interface, gateway and firewall rule on the OPNsense side."
msgstr "自动：同时创建 OPNsense 侧的接口、网关与防火墙规则。"

msgid "Invalid log level."
msgstr "无效的日志层级。"

msgid "Invalid mode."
msgstr "无效的模式。"

msgid "Let mihomo answer DNS queries itself (needed for fake-ip mode and rule based resolution)."
msgstr "由 mihomo 自行应答 DNS 查询（fake-ip 模式与基于规则的解析需要）。"

msgid "Loading …"
msgstr "加载中 …"

msgid "Log Viewer"
msgstr "日志视图"

msgid "Log file cleared."
msgstr "日志已清空。"

msgid "Loopback address and port mihomo listens on for DNS, e.g. 127.0.0.1:1053."
msgstr "mihomo 监听 DNS 的回环地址与端口，例如 127.0.0.1:1053。"

msgid "Make sure the TUN device wins over other default routes while the service is running."
msgstr "服务运行时，确保 TUN 设备优先于其它默认路由。"

msgid "Manual: make sure the interface is policy routed into the TUN device."
msgstr "手动模式：请自行确保该接口的策略路由指向 TUN 设备。"

msgid "Maximum transmission unit of the TUN device."
msgstr "TUN 设备的最大传输单元。"

msgid "Memory / Core Version"
msgstr "内存 / 内核版本"

msgid "Mihomo"
msgstr "Mihomo"

msgid "Mode switched to %s."
msgstr "已切换到 %s 模式。"

msgid "Network side"
msgstr "网络侧"

msgid "No output from the configuration test."
msgstr "配置校验没有输出。"

msgid "No proxy groups are defined in the configuration."
msgstr "配置中未定义代理分组。"

msgid "No rule would be generated: every row is disabled, has no source, or has no outbound selected."
msgstr "不会生成任何规则：所有行要么未启用、要么没有源、要么没有选出站。"

msgid "OPNsense changes"
msgstr "OPNsense 变更"

msgid "OPNsense side"
msgstr "网络侧"

msgid "On the next reboot mihomo will take over routing as soon as it starts. Verify the configuration before you reboot."
msgstr "下次重启后 mihomo 一启动就会接管路由。重启前请先确认配置无误。"

msgid "Only HTTP or HTTPS subscription URLs are allowed."
msgstr "订阅地址仅允许使用 HTTP 或 HTTPS。"

msgid "Optional. Empty uses the interface network."
msgstr "可留空，默认使用接口网段。"

msgid "Optional. Leave empty to use the interface network, or enter a CIDR like 192.168.1.0/24."
msgstr "可留空以使用接口网段，或填写 CIDR（如 192.168.1.0/24）。"

msgid "POST required."
msgstr "需要 POST 请求。"

msgid "Pick an interface, e.g. lan or opt2."
msgstr "请选择接口，例如 lan 或 opt2。"

msgid "Placeholder proxy nodes detected"
msgstr "检测到占位节点"

msgid "Please review before starting the service"
msgstr "启动服务前请先确认以下风险"

msgid "Policy Routing"
msgstr "路由策略"

msgid "Policy routing is active"
msgstr "策略路由已启用"

msgid "Policy routing is in place."
msgstr "策略路由已就位。"

msgid "Port of the RESTful controller."
msgstr "RESTful 控制器的端口。"

msgid "Preview"
msgstr "预览"

msgid "Proxy Groups"
msgstr "代理分组"

msgid "Proxy Suite"
msgstr "Proxy Suite"

msgid "Proxy group \"%s\" does not exist in the current configuration file."
msgstr "代理组 \"%s\" 不在当前配置文件里。"

msgid "Proxy group name, e.g. 🇺🇸United States. Ignored when the scope is \"direct\"."
msgstr "代理组名字，例如 🇺🇸United States；规则范围为“直连”时忽略。"

msgid "Proxy group. Ignored for the direct scope."
msgstr "代理组；直连范围下忽略。"

msgid "Restart After Update"
msgstr "更新后重启"

msgid "Restart mihomo automatically once a subscription update finished successfully. Keep this off until you have verified the new nodes."
msgstr "订阅更新成功后自动重启 mihomo。在确认新节点可用之前请保持关闭。"

msgid "Restart mihomo right after a successful subscription update."
msgstr "订阅更新成功后立即重启 mihomo。"

msgid "Restart service after a successful update"
msgstr "更新成功后重启服务"

msgid "Restart service?"
msgstr "重启服务？"

msgid "Restart the service after applying"
msgstr "应用后重启服务"

msgid "Restore the most recent config.xml backup and reload the firewall?"
msgstr "要还原本插件最近一次创建的 config.xml 备份并重新加载防火墙吗？"

msgid "Roll back"
msgstr "回滚"

msgid "Roll back the OPNsense side"
msgstr "回滚 OPNsense 网络侧"

msgid "Save failed"
msgstr "保存失败"

msgid "Scope"
msgstr "规则范围"

msgid "Secret that the subscription updater writes into the generated configuration."
msgstr "订阅更新器写入生成配置的密钥。"

msgid "Service is enabled at boot but not running"
msgstr "已设置为开机自启，但当前未运行"

msgid "Service is not enabled; nothing to restart."
msgstr "服务未启用，无需重启。"

msgid "Service is running and enabled at boot"
msgstr "服务正在运行且已开机自启"

msgid "Service restart requested."
msgstr "已请求重启服务。"

msgid "Service will not start automatically on boot."
msgstr "服务不会在开机时自动启动。"

msgid "Service will start automatically on boot."
msgstr "服务将在开机时自动启动。"

msgid "Set a secret in the configuration, otherwise the API is unauthenticated."
msgstr "请在配置中设置密钥，否则 API 将无需认证。"

msgid "Set a subscription URL before starting an update."
msgstr "请先设置订阅地址再执行更新。"

msgid "Settings applied"
msgstr "设置已应用"

msgid "Settings imported"
msgstr "设置已导入"

msgid "Settings imported from the active configuration."
msgstr "已从当前配置导入设置。"

msgid "Settings saved"
msgstr "设置已保存"

msgid "Shared secret for the controller API. Leave empty only if the controller is bound to the loopback address."
msgstr "控制器 API 的共享密钥。只有当控制器绑定在回环地址时才可留空。"

msgid "Stack"
msgstr "协议栈"

msgid "Start Subscription"
msgstr "开始订阅"

msgid "Start the mihomo service at boot time. It is deliberately disabled by default: with TUN automatic route takeover enabled, starting an unconfigured proxy takes the whole network offline."
msgstr "开机时启动 mihomo 服务。默认刻意关闭：在开启 TUN 自动接管路由的情况下，未配置好就启动代理会让整个网络断网。"

msgid "Starting the service will insert routes for all IPv4 traffic into the TUN device. If the proxy nodes are not reachable or not configured, every device behind this firewall loses Internet access."
msgstr "启动服务会把所有 IPv4 流量的路由指向 TUN 设备。若节点不可达或尚未配置，本机后面所有设备都会失去网络。"

msgid "Strict Route"
msgstr "严格路由"

msgid "Strict route is enabled"
msgstr "已启用严格路由"

msgid "Subscription Management"
msgstr "订阅管理"

msgid "Subscription URL"
msgstr "订阅地址"

msgid "Subscription log"
msgstr "订阅日志"

msgid "Subscription settings saved."
msgstr "订阅设置已保存。"

msgid "Subscription task submitted; follow the log for progress."
msgstr "订阅任务已提交，请查看日志了解进度。"

msgid "Subscription update failed"
msgstr "订阅更新失败"

msgid "Subscription update started"
msgstr "订阅更新已开始"

msgid "Switched \"%s\" to \"%s\"."
msgstr "已将 \"%s\" 切换到 \"%s\"。"

msgid "TUN Device"
msgstr "TUN 设备"

msgid "TUN Mode"
msgstr "TUN 模式"

msgid "TUN is disabled: these rules are written and validated, but no traffic reaches mihomo yet."
msgstr "TUN 已关闭：规则会写入并通过校验，但暂时没有流量进入 mihomo。"

msgid "TUN is disabled: traffic does not reach mihomo."
msgstr "TUN 已关闭：流量不会进入 mihomo。"

msgid "TUN mode is enabled (automatic route takeover off)"
msgstr "已启用 TUN 模式（未自动接管路由）"

msgid "TUN off"
msgstr "TUN 未启用"

msgid "TUN with automatic route takeover is enabled"
msgstr "已启用 TUN 且自动接管路由"

msgid "Test Active Configuration"
msgstr "校验当前配置"

msgid "The TUN device is guaranteed to win over other default routes while the service runs."
msgstr "服务运行时，TUN 设备将优先于其它默认路由。"

msgid "The configuration file was not written. mihomo rejected it:%s"
msgstr "配置文件未写入，mihomo 校验未通过：%s"

msgid "The configuration still contains the placeholder server 88.88.88.88 shipped with the plugin. Replace it with a real subscription or real proxy nodes before starting the service."
msgstr "配置里仍是随包分发的占位服务器 88.88.88.88。请在启动服务前换成真实订阅或真实节点。"

msgid "The controller is not reachable. Start the service to see proxy groups."
msgstr "控制器不可达；启动服务后可查看代理分组。"

msgid "The full mihomo configuration. It is validated with \"mihomo -t\" before it replaces the active file, and the previous file is kept as a timestamped backup."
msgstr "完整的 mihomo 配置。落盘前会先用 \"mihomo -t\" 校验，并保留带时间戳的备份。"

msgid "The running service keeps its current in-memory configuration until it is restarted."
msgstr "运行中的服务在重启前仍使用内存中的旧配置。"

msgid "The selected log file will be emptied."
msgstr "选中的日志文件将被清空。"

msgid "The service is not enabled at boot."
msgstr "服务未设置为开机自启。"

msgid "The service is stopped. Use the start button in the page header to bring it up."
msgstr "服务已停止，可用页面右上角的启动按钮将其拉起。"

msgid "The service will be restarted right after the update, which rebuilds the TUN device and its routes. Make sure the new nodes work, otherwise clients behind this firewall may lose connectivity."
msgstr "更新后会立即重启服务，这会重建 TUN 设备及其路由。请确认新节点可用，否则本机后面的客户端可能断网。"

msgid "The subscription script is not installed; subscription updates are unavailable."
msgstr "未安装订阅脚本，无法执行订阅更新。"

msgid "Total Downloaded / Uploaded"
msgstr "累计下载 / 上传"

msgid "Traffic from these interfaces is routed into the mihomo TUN device: %s. While the service is stopped or fails to start, clients on these interfaces lose Internet access."
msgstr "这些接口的流量会被策略路由进 mihomo 的 TUN 设备：%s。在服务停止或启动失败期间，这些接口上的客户端会断网。"

msgid "Traffic only enters the TUN device when firewall or policy routing sends it there."
msgstr "仅当防火墙或策略路由把流量送入 TUN 设备时才会走代理。"

msgid "Unable to create a staging file in /tmp."
msgstr "无法在 /tmp 创建临时文件。"

msgid "Unable to reach the mihomo external controller."
msgstr "无法连接 mihomo 外部控制器。"

msgid "Unable to write the staging file."
msgstr "无法写入临时文件。"

msgid "Unknown log file."
msgstr "未知的日志文件。"

msgid "Use %sSettings%s to enable it, then start it from the controls in the page header."
msgstr "请到 %s设置%s 中启用，然后使用页面右上角的控件启动。"

msgid "Use up to 128 characters: letters, digits, \".\", \"-\" and \"_\"."
msgstr "最多 128 个字符：字母、数字、\".\"、\"-\" 和 \"_\"。"

msgid "Validate"
msgstr "校验"

msgid "Validation failed"
msgstr "校验未通过"

msgid "Validation passed"
msgstr "校验通过"

msgid "Verbosity of the mihomo log file. Use \"error\" or \"silent\" for long term operation to keep the log small."
msgstr "mihomo 日志的详细程度。长期运行时建议用 \"error\" 或 \"silent\" 以免日志过大。"

msgid "Waiting for the OPNsense side: interface, gateway and policy routing rule."
msgstr "等待同步 OPNsense 网络侧：接口、网关与策略路由规则。"

msgid "Writes config.yaml, the subscription template, and (if needed) config.xml. A config.xml backup is created automatically."
msgstr "将写入 config.yaml、订阅模板，必要时写 config.xml（自动备份）。"

msgid "auto-route on"
msgstr "自动接管路由已开"

msgid "bytes"
msgstr "字节"

msgid "external-controller is bound to %s. Anyone who can reach that address and knows the secret can reconfigure the proxy. Bind it to 127.0.0.1 — this WebGUI talks to the controller over the loopback interface only."
msgstr "external-controller 绑定在 %s。任何能访问该地址并知道密钥的人都能改代理配置。建议改为 127.0.0.1 —— 本 WebGUI 只通过回环接口与控制器通信。"

msgid "fake-ip returns a synthetic address and resolves on connection; redir-host resolves up front and reports real addresses."
msgstr "fake-ip 返回合成地址、在建立连接时才解析；redir-host 提前解析并返回真实地址。"

msgid "gvisor is the most compatible option on FreeBSD; system may fail under some conditions; mixed combines both."
msgstr "gvisor 在 FreeBSD 上兼容性最好；system 在某些环境下可能失败；mixed 两者兼用。"

msgid "in effect"
msgstr "生效中"

msgid "mihomo is active and will start again after a reboot."
msgstr "mihomo 正在运行，并会在重启后自动启动。"

msgid "mihomo rules"
msgstr "mihomo 规则"

msgid "not running"
msgstr "未运行"

msgid "not synchronized"
msgstr "未同步"

msgid "nothing bound"
msgstr "未绑定任何接口"

msgid "rule"
msgstr "规则"

msgid "rule: follow the routing rules (normal operation) global: send everything through the selected proxy direct: bypass every proxy"
msgstr "rule：按分流规则处理（常规用法）；global：全部走所选节点；direct：全部直连。"

msgid "…"
msgstr "未知"
